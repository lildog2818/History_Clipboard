<Window x:Class="ClipboardHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ClipboardHistory"
        Title="剪贴板历史" Width="460" Height="720" MinWidth="360" MinHeight="500"
        WindowStyle="None" AllowsTransparency="False" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        ShowActivated="True" Loaded="Window_Loaded" Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="10" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:ImagePathConverter x:Key="ImgConv"/>
        <local:HighlightConverter x:Key="HlConv"/>
        <local:CardWidthConverter x:Key="CardConv"/>

        <Style x:Key="TabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource PanelBackground}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Grid Grid.Row="0" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="剪贴板历史" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundBrush}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Click="Max_Click"
                            Content="&#xE922;" ToolTip="最大化/还原"/>
                    <Button x:Name="SettingsBtn" Style="{StaticResource WinBtn}" Click="Settings_Click"
                            Content="&#xE713;" ToolTip="设置"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource WinBtnClose}" Click="Close_Click"
                            Content="&#xE8BB;" ToolTip="关闭" Margin="0,0,4,0"/>
                </StackPanel>
            </Grid>

            <!-- 页签 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0">
                <RadioButton x:Name="TextTab" Content="文字" GroupName="Tabs" Style="{StaticResource TabStyle}"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="ImageTab" Content="图片" GroupName="Tabs" Style="{StaticResource TabStyle}"
                             Checked="Tab_Checked"/>
                <RadioButton x:Name="FileTab" Content="文件" GroupName="Tabs" Style="{StaticResource TabStyle}"
                             Checked="Tab_Checked"/>
            </StackPanel>

            <!-- 搜索框 -->
            <Border Grid.Row="2" Margin="12,4,12,8" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Padding="36,0,36,0" Background="Transparent"
                             Foreground="{DynamicResource ForegroundBrush}" BorderThickness="0" FontSize="16"
                             VerticalContentAlignment="Center" Height="40"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <TextBlock x:Name="Hint" Text="搜索剪贴板历史…" Foreground="{DynamicResource SecondaryBrush}"
                               FontSize="16" VerticalAlignment="Center" Margin="38,0,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="ClearBtn" Style="{StaticResource WinBtn}" Content="&#xE711;" ToolTip="清空"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                            Click="Clear_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- 文字页 -->
            <ListBox x:Name="TextList" Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="8,0,8,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="TextList_MouseDoubleClick"
                     PreviewMouseRightButtonUp="TextList_RightClick"
                     PreviewKeyDown="List_PreviewKeyDown" SelectionChanged="TextList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PinText}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ContentControl Content="{Binding DisplayText, Converter={StaticResource HlConv}}"
                                            HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 图片页（卡片网格） -->
            <ListBox x:Name="ImageGrid" Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="8,0,8,0"
                     Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="ImageGrid_PreviewMouseLeftButtonDown"
                     PreviewMouseRightButtonUp="ImageGrid_RightClick"
                     PreviewKeyDown="List_PreviewKeyDown" SelectionChanged="ImageGrid_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardItem}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="{Binding ActualWidth, ElementName=ImageGrid, Converter={StaticResource CardConv}}"
                              Height="{Binding ActualWidth, ElementName=ImageGrid, Converter={StaticResource CardConv}}">
                            <Image Source="{Binding ImageFile, Converter={StaticResource ImgConv}}" Stretch="UniformToFill"/>
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" Margin="6" Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 文件页 -->
            <ListBox x:Name="FileList" Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="8,0,8,0"
                     Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="FileList_MouseDoubleClick"
                     PreviewMouseRightButtonUp="FileList_RightClick"
                     PreviewKeyDown="List_PreviewKeyDown" SelectionChanged="FileList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PinText}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ContentControl Content="{Binding DisplayText, Converter={StaticResource HlConv}}"
                                            HorizontalContentAlignment="Stretch" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 预览面板 -->
            <Border Grid.Row="4" x:Name="PreviewPanel" Margin="8,8,8,4" Padding="10" Height="170"
                    Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBox x:Name="PreviewText" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource ForegroundBrush}" FontSize="14"/>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                        <ListBox x:Name="PreviewFiles" Background="Transparent" BorderThickness="0" FontSize="13"
                                 Foreground="{DynamicResource ForegroundBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="PreviewNote" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" MaxWidth="200"/>
                        <TextBlock x:Name="PreviewMeta" FontSize="12" Foreground="{DynamicResource SecondaryBrush}"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底部提示 -->
            <TextBlock Grid.Row="5" x:Name="StatusText" Margin="14,2,14,10" FontSize="12"
                       Foreground="{DynamicResource SecondaryBrush}"
                       Text="快捷键唤起：双击粘贴 · 托盘打开：双击复制 · 单击预览（图片单击贴图）· 右键更多"/>

            <!-- 复制成功提示 -->
            <Border x:Name="Toast" Grid.RowSpan="6" Background="#CC1A1D22" CornerRadius="10" Padding="18,10"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,46"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Text="已复制" Foreground="White" FontSize="14"/>
            </Border>
        </Grid>
    </Border>
</Window>
