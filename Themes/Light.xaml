<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Win11 Fluent · 浅色 -->
    <SolidColorBrush x:Key="PanelBackground" Color="#F2F3F3F3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDFDFD"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#FF646464"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#24000000"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF005FB8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A005FB8"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0E000000"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#26005FB8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#FFFFFFFF"/>
</ResourceDictionary>
